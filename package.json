{
  "name": "clocktower-trouble-brewing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @clocktower/web --filter @clocktower/server dev",
    "build": "pnpm -r --if-present run build",
    "test": "vitest run packages apps/server/src",
    "test:e2e": "pnpm build && playwright test",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/ws": "8.18.1",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.7",
    "ws": "8.18.3"
  }
}
